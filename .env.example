# ========================================================
#   Frappe CRM Azerbaijan - Environment Configuration
# ========================================================
# Bu fayldakı parametrləri istəyinizə uyğun dəyişə bilərsiniz.
# Əgər heç nə dəyişməsəniz, sistem standart etibarlı parametrlərlə
# 1 komanda ilə tam hazır vəziyyətdə işə düşəcəkdir.

# --- Şəbəkə və Giriş Parametrləri ---
# Host maşınında açılacaq port (0.0.0.0:CRM_PORT -> Lokalda hər kəsə açıqdır)
CRM_PORT=8080

# Frappe Sayt Adı
FRAPPE_SITE_NAME=frontend

# --- Administrator Hesabı ---
# CRM Giriş İstifadəçisi: Administrator
ADMIN_PASSWORD=admin

# --- Verilənlər Bazası (MariaDB) ---
DB_HOST=db
DB_PORT=3306
MYSQL_ROOT_PASSWORD=admin
MARIADB_ROOT_PASSWORD=admin

# --- Redis (Keş və Növbə) ---
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379
SOCKETIO_PORT=9000

# --- Regional və Lokalizasiya Ayarları ---
DEFAULT_COUNTRY=Azerbaijan
DEFAULT_TIMEZONE=Asia/Baku
DEFAULT_CURRENCY=AZN
DEFAULT_CURRENCY_SYMBOL=₼
DEFAULT_LANGUAGE=tr
DATE_FORMAT=dd-mm-yyyy
TIME_FORMAT=HH:mm:ss

# --- İnkişaf Etdirici Rejimi ---
DEVELOPER_MODE=1
MUTE_EMAILS=1
